# SkillSwap Platform

users = []
while True:
    print("\n===== SKILLSWAP PLATFORM =====")
    print("1. Register User")
    print("2. View Users")
    print("3. Find Skill")
    print("4. Exit")
    choice = input("Enter your choice: ")
    if choice == "1":
        name = input("Enter your name: ")
        teach = input("Skill you can teach: ")
        learn = input("Skill you want to learn: ")
        users.append({
            "name": name,
            "teach": teach,
            "learn": learn
        })
        print("User registered successfully!")
    elif choice == "2":
        print("\n----- Registered Users -----")
        if not users:
            print("No users registered.")
        else:
            for user in users:
                print("Name:", user["name"])
                print("Can Teach:", user["teach"])
                print("Wants to Learn:", user["learn"])
                print("---------------------------")
    elif choice == "3":
        skill = input("Enter the skill you want to learn: ")
        print("\n----- Skill Matches -----")
        found = False
        for user in users:
            if user["teach"].lower() == skill.lower():
                print(user["name"], "can teach", user["teach"])
                found = True
        if not found:
            print("No matching user found.")
    elif choice == "4":
        print("Thank you for using SkillSwap!")
        break
